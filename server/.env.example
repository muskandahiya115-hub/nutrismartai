# Required: comma-separated list of frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Required for the contact form: your Supabase project credentials.
# Copy both values from your Supabase dashboard (Settings, then API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional locally; Render injects PORT automatically.
PORT=5000
